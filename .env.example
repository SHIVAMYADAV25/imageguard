# ---- Discovery providers (all optional; connectors without a key are skipped) ----
SERPAPI_KEY=            # Google Lens + Yandex reverse image + Google text search (serpapi.com)
TINEYE_API_KEY=         # TinEye commercial API (supports direct upload; no public URL needed)

# ---- Temporary public URL for the query image ----
# Google Lens / Yandex (via SerpApi) fetch the image by URL. Run a tunnel to the temp host, e.g.
#   cloudflared tunnel --url http://localhost:8787     (or: ngrok http 8787)
# and paste the https URL here. The image is served once-ish, with a random token, for ~2 minutes.
PUBLIC_BASE_URL=
HOST_PORT=8787

# ---- Misc ----
USER_AGENT=ImageGuardBot/0.1 (+https://your-domain.example/bot; contact: you@example.com)
ENABLE_OCR=1            # PaddleOCR reads text in the upload (handles, watermark domains). 0 = skip
DEBUG=0
